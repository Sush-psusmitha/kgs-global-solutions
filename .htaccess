<IfModule mod_rewrite.c>
RewriteEngine On

# ----------------------------------------------------------------------
# Canonical Domain (Force HTTPS + WWW)
# ----------------------------------------------------------------------
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.kotnaniglobal\.com$ [NC]
RewriteRule ^ https://www.kotnaniglobal.com%{REQUEST_URI} [R=301,L,NE]

# ----------------------------------------------------------------------
# Remove index.html / index.htm / index.php from homepage
# ----------------------------------------------------------------------
RewriteRule ^index\.(html?|php)$ https://www.kotnaniglobal.com/ [R=301,L,NC]

</IfModule>

# Default Directory Index
DirectoryIndex index.html index.php

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
